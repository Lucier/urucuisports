# Banco de dados PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/urucuisportes

# URL pública da aplicação (sem barra no final)
NEXT_PUBLIC_API_URL=https://seu-dominio.com

# Segredo para assinatura JWT — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_FORTE_DE_64_CARACTERES

# Sentry — obtenha em https://sentry.io (deixe em branco para desativar)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
